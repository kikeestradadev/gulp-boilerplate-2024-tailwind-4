include ../storybook-section

+storybookSection('Cards', 'Cards de cursos')
	block preview
		div(class="grid grid-cols-1 sm:grid-cols-2 l:grid-cols-4 gap-5")
			-for (let i = 0; i < 4; i++)
				article(class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm")
					div(class="aspect-video bg-[#3cafc8] flex items-center justify-center p-4")
						span(class="text-center text-sm font-bold text-white") Programación Orientada a Objetos GO
					div(class="border-t border-gray-200 p-4")
						h4(class="text-[length:var(--h4-size)] leading-[length:var(--h4-line)] font-semibold text-center mb-3") Programación orientada a objetos con Go
						div(class="mb-3 flex items-center justify-center gap-2")
							div(class="h-8 w-8 rounded-full bg-gray-300")
							span(class="text-[length:var(--p-size)] leading-[length:var(--p-line)]") Alejandro Rodríguez
						div(class="text-center")
							span(class="inline-block rounded border-2 border-[var(--third-color)] px-4 py-1 font-bold text-[var(--third-color)]") $ 20USD

	block markdown
		include:markdown-it(html) ../../../md/storybook/cards.md

	block markup
		pre(class="language-html !m-0 !rounded-none")
			code(class="language-html").
				<article class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
				  <div class="aspect-video bg-[#3cafc8] flex items-center justify-center p-4">
				    <img src="path/img.jpg" alt="Programación Orientada a Objetos GO">
				  </div>
				  <div class="border-t border-gray-200 p-4">
				    <h3 class="text-[length:var(--h4-size)] leading-[length:var(--h4-line)] font-semibold text-center mb-3">
				      Programación orientada a objetos con Go
				    </h3>
				    <div class="mb-3 flex items-center justify-center gap-2">
				      <div class="h-8 w-8 rounded-full bg-gray-300">
				        <img src="path/avatar.jpg" alt="Alejandro Rodríguez">
				      </div>
				      <span class="text-[length:var(--p-size)] leading-[length:var(--p-line)]">
				        Alejandro Rodríguez
				      </span>
				    </div>
				    <div class="text-center">
				      <span class="inline-block rounded border-2 border-[var(--third-color)] px-4 py-1 font-bold text-[var(--third-color)]">
				        $ 20USD
				      </span>
				    </div>
				  </div>
				</article>
