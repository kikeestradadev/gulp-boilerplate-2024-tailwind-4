include ../storybook-section

+storybookSection('Tipografía', 'Headlines, listas y párrafos')
	block preview
		hr(class="mb-8 border-0 border-t-2 border-[var(--storybook-divider)]")
		h1(class="text-[length:var(--h1-size)] leading-[length:var(--h1-line)] font-bold") h1
		h2(class="text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold") h2
		h3(class="text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold") h3
		h4(class="text-[length:var(--h4-size)] leading-[length:var(--h4-line)] font-semibold") h4
		h5(class="text-[length:var(--h5-size)] leading-[length:var(--h5-line)] font-semibold") h5
		h6(class="text-[length:var(--h6-size)] leading-[length:var(--h6-line)] font-semibold") h6
		ul(class="my-6 list-disc pl-10")
			li(class="text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]") Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.
			li(class="text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]") Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.
		hr(class="my-8 border-0 border-t-2 border-[var(--storybook-divider)]")
		p(class="mb-5 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]")
			| Lorem ipsum dolor sit amet consectetur, adipisicing elit. Quasi,
			| dolorem autem maiores quis dolor, reprehenderit delectus quia dolore,
			| incidunt obcaecati sequi labore hic? Soluta doloremque vitae explicabo
			| assumenda fugit tenetur.

	block markdown
		include:markdown-it(html) ../../../md/storybook/typography.md

	block markup
		pre(class="language-html !m-0 !rounded-none")
			code(class="language-html").
				<h1 class="text-[length:var(--h1-size)] leading-[length:var(--h1-line)] font-bold">h1</h1>
				<h2 class="text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold">h2</h2>
				<h3 class="text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold">h3</h3>
				<ul class="my-6 list-disc pl-10">
				  <li class="text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]">
				    Item de lista
				  </li>
				</ul>
				<p class="text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)] mb-5">
				  Párrafo de ejemplo.
				</p>
