-
	const buttonsModuleData = {
		title: 'Botones y enlaces',
		lead: 'Variantes y tamanos. El hover se prueba al pasar el cursor (solo desktop).',
		label: 'Subscribe',
		link: {
			label: 'Example of Link',
			href: '#',
		},
		variants: [
			{
				name: 'Primary',
				className: 'inline-flex items-center justify-center gap-2 border-2 border-[var(--btn-primary)] bg-[var(--btn-primary)] px-5 py-3.5 text-sm font-semibold tracking-wide text-[var(--btn-text)] uppercase no-underline transition-[background-color,border-color,color] duration-200 l:px-6 l:py-4 l:text-base [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:text-[var(--btn-text)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
				hex: 'var(--btn-primary)',
			},
			{
				name: 'Secondary',
				className: 'inline-flex items-center justify-center gap-2 border-2 border-[var(--btn-secondary)] bg-[var(--btn-secondary)] px-5 py-3.5 text-sm font-semibold tracking-wide text-[var(--btn-text)] uppercase no-underline transition-[background-color,border-color,color] duration-200 l:px-6 l:py-4 l:text-base [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-secondary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-secondary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:text-[var(--btn-text)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
				hex: 'var(--btn-secondary)',
			},
			{
				name: 'Outline',
				className: 'inline-flex items-center justify-center gap-2 border-2 border-[var(--btn-secondary)] bg-transparent px-5 py-3.5 text-sm font-semibold tracking-wide text-[var(--btn-secondary)] uppercase no-underline transition-[background-color,border-color,color] duration-200 l:px-6 l:py-4 l:text-base [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-secondary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-transparent [@media(hover:hover)_and_(pointer:fine)]:hover:text-[var(--btn-secondary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
				hex: 'var(--btn-secondary)',
			},
		],
		sizes: [
			{
				name: 'Large',
				className: 'inline-flex items-center justify-center gap-2 border-2 border-[var(--btn-primary)] bg-[var(--btn-primary)] px-5 py-4 text-base font-semibold tracking-wide text-[var(--btn-text)] uppercase no-underline transition-[background-color,border-color,color] duration-200 l:p-6 l:text-xl [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
				note: 'Desktop: 20px / 1.5rem',
			},
			{
				name: 'Normal',
				className: 'inline-flex items-center justify-center gap-2 border-2 border-[var(--btn-primary)] bg-[var(--btn-primary)] px-5 py-3.5 text-sm font-semibold tracking-wide text-[var(--btn-text)] uppercase no-underline transition-[background-color,border-color,color] duration-200 l:px-6 l:py-4 l:text-base [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
				note: 'Desktop: 16px / 1rem 1.5rem',
			},
			{
				name: 'Small',
				className: 'inline-flex items-center justify-center gap-2 border-2 border-[var(--btn-primary)] bg-[var(--btn-primary)] px-4 py-3 text-xs font-semibold tracking-wide text-[var(--btn-text)] uppercase no-underline transition-[background-color,border-color,color] duration-200 [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
				note: 'Desktop: 12px / 0.75rem 1rem',
			},
		],
	}

section(id='botones' class="w-full max-w-[var(--main-container)] mx-auto px-[15px] border border-[steelblue]")
	div(class="w-full max-w-[var(--container)] mx-auto")
		h2(class="text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold mb-3")= buttonsModuleData.title
		p(class="mb-8 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]")= buttonsModuleData.lead

		h3(class="text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold mb-4") Variantes
		div(class="mb-10 flex flex-wrap gap-6")
			each variant in buttonsModuleData.variants
				div(class="flex min-w-[10rem] flex-col gap-3")
					p(class="m-0 text-sm font-semibold text-[var(--paragraph-color)]")= variant.name
					a(class=variant.className href="#")= buttonsModuleData.label
					p(class="m-0 flex items-center gap-2 text-xs text-gray-500")
						span(class="inline-block size-3 rounded-sm border border-black/10" style=`background-color: ${variant.hex}`)
						| #{variant.hex}

		h3(class="text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold mb-4") Tamanos
		div(class="mb-10 flex flex-wrap items-end gap-6")
			each size in buttonsModuleData.sizes
				div(class="flex flex-col gap-3")
					p(class="m-0 text-sm font-semibold text-[var(--paragraph-color)]")= size.name
					a(class=size.className href="#")= buttonsModuleData.label
					p(class="m-0 text-xs text-gray-500")= size.note

		h3(class="text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold mb-4") Enlaces
		p(class="mb-4 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]")
			a(href=buttonsModuleData.link.href)= buttonsModuleData.link.label
		p(class="mb-0 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]")
			| Lorem ipsum dolor sit amet,
			|
			a(href=buttonsModuleData.link.href)= buttonsModuleData.link.label
			|  consectetur adipisicing elit.
