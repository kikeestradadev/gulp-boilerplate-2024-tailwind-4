-
	const styleGuideContainerData = {
		panelTitle: 'Documentacion',
		items: [
			{ label: 'Colores', href: '#colores' },
			{ label: 'Tipografia', href: '#tipografia' },
			{ label: 'Botones', href: '#botones' },
			{ label: 'Editor CSS', href: '#editor-css' },
			{ label: 'Flex', href: '#flex' },
			{ label: 'Grid', href: '#grid' },
			{ label: 'JSON', href: '#json-data' },
			{ label: 'Listas', href: '#listas' },
			{ label: 'Markdown', href: '#markdown' },
			{ label: 'Sidebar', href: '#sidebar' },
			{ label: 'Sprite SVG', href: '#sprite-svg' },
			{ label: 'Tabla', href: '#tabla' },
			{ label: 'Texto', href: '#texto' },
		],
	}

mixin styleGuideNavLink(item, variant)
	- const baseClass = 'style-guide-container__nav-link group flex items-center justify-between gap-3 no-underline transition-[background-color,color] duration-200'
	- const desktopClass = 'rounded-md px-[0.85rem] py-[0.65rem] text-[0.9375rem] font-medium text-[var(--paragraph-color)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-black/5 [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline [&.is-active]:font-bold [&.is-active]:text-[var(--first-color)]'
	- const mobileClass = 'rounded-none border-b border-white/10 px-1 py-[0.85rem] text-[0.9375rem] font-medium text-gray-200 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-transparent [@media(hover:hover)_and_(pointer:fine)]:hover:text-white [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline [&.is-active]:font-bold [&.is-active]:text-[var(--third-color)]'
	- const chevronDesktop = 'size-[0.4rem] shrink-0 rotate-[-45deg] border-r-2 border-b-2 border-transparent opacity-0 transition group-[.is-active]:border-current group-[.is-active]:opacity-100'
	- const chevronMobile = 'size-[0.4rem] shrink-0 rotate-[-45deg] border-r-2 border-b-2 border-transparent opacity-0 transition group-[.is-active]:border-current group-[.is-active]:opacity-100'
	a(
		class=`${baseClass} ${variant === 'mobile' ? mobileClass : desktopClass}`
		href=item.href
	)
		= item.label
		span(
			class=variant === 'mobile' ? chevronMobile : chevronDesktop
			aria-hidden='true'
		)

section(class='style-guide-container group w-full max-w-[var(--main-container)] mx-auto px-[15px]')
	div(class='w-full max-w-[var(--container)] mx-auto')
		div(class='grid gap-8 l:grid-cols-[14rem_minmax(0,1fr)] l:gap-12 l:items-start')
			nav(
				class='style-guide-container__nav style-guide-container__nav--desktop hidden l:block sticky top-[calc(var(--header-height)+1rem)] rounded-lg bg-gray-100 p-3'
				aria-label='Style guide'
			)
				ul(class='style-guide-container__nav-list m-0 flex list-none flex-col gap-1 p-0')
					each item in styleGuideContainerData.items
						li(class='style-guide-container__nav-item m-0')
							+styleGuideNavLink(item, 'desktop')

			div(class='style-guide-container__content flex min-w-0 flex-col gap-[var(--section-gap)] [&_section]:scroll-mt-[calc(var(--header-height)+1rem)]')
				include color-table
				include typography-module
				include buttons-module
				include editor-css
				include flex-module
				include grid-module
				include json-data
				include list-module
				include markdown
				include sidebar-module
				include sprite-svg
				include table-module
				include text-module

	div(class='style-guide-container__mobile l:hidden')
		div(
			class='style-guide-container__panel fixed right-4 bottom-[5.5rem] z-[120] flex max-h-[min(70vh,32rem)] w-[min(20rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-xl bg-[#2d3e4f] p-4 shadow-[0_16px_40px_rgba(0,0,0,0.28)]'
			id='style-guide-panel'
			hidden
		)
			p(class='style-guide-container__panel-title mb-3 text-[0.9375rem] font-semibold text-[#c5cdd6]')= styleGuideContainerData.panelTitle
			nav(
				class='style-guide-container__nav style-guide-container__nav--mobile'
				aria-label='Style guide mobile'
			)
				ul(class='style-guide-container__nav-list m-0 flex max-h-[min(55vh,26rem)] list-none flex-col gap-1 overflow-y-auto p-0 pr-1')
					each item in styleGuideContainerData.items
						li(class='style-guide-container__nav-item m-0')
							+styleGuideNavLink(item, 'mobile')

		button(
			class='style-guide-container__fab fixed right-4 bottom-4 z-[130] inline-flex size-14 cursor-pointer items-center justify-center rounded-full border-0 bg-[var(--second-color)] text-white shadow-[0_8px_24px_rgba(0,123,223,0.35)] transition-[transform,background-color,box-shadow] duration-200 [@media(hover:hover)_and_(pointer:fine)]:hover:-translate-y-0.5 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--second-color-alt)] focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[var(--first-color)]'
			type='button'
			aria-expanded='false'
			aria-controls='style-guide-panel'
			aria-label='Abrir navegacion del style guide'
		)
			span(
				class='style-guide-container__fab-icon style-guide-container__fab-icon--open absolute text-[1.75rem] leading-none font-normal group-[.is-nav-open]:hidden'
				aria-hidden='true'
			) +
			span(
				class='style-guide-container__fab-icon style-guide-container__fab-icon--close absolute hidden text-[2rem] leading-none font-normal group-[.is-nav-open]:block'
				aria-hidden='true'
			) ×
